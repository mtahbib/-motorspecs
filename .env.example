# =============================================================================
# MotorSpecs environment variables
#
# Leave the Supabase values EMPTY to run in demo mode (no credentials needed):
# an embedded PostgreSQL runs the same migrations, RLS and demo seed locally.
# Fill all three Supabase values to connect a real project.
# Copy to .env.local — never commit real values.
# =============================================================================

# Public site URL (used for OAuth / email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (all three required for Supabase mode) --------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# SERVER-ONLY secret. The app switches to the `authenticated` role with the
# signed-in user's JWT claims for every query, so RLS still applies.
DATABASE_URL=
# Optional: max pooled connections per server instance (Free tier: keep small)
DATABASE_POOL_MAX=5

# NOT USED by this app — never add the service-role key to a NEXT_PUBLIC_ variable.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional -----------------------------------------------------------------
# Force a mode: "demo" or "supabase" (default: auto-detect from the values above)
MOTORSPECS_MODE=
# Demo mode session signing secret (auto-generated into .demo-data/ if empty)
DEMO_SESSION_SECRET=
# Demo mode: keep the embedded database in memory only (resets on restart)
DEMO_DB_IN_MEMORY=false
